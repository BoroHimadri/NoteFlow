{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "echo \"skip next build - socket server only\"",
    "watchPatterns": ["server/**", "package.json", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "node server/socket-server.cjs",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
